<%= form_with model: @article, multipart: true do |form| %>
  <% if @article.errors.any? %>
    <% @article.errors.full_messages.each do |msg| %>
      <p style="color:red"><%= msg %></p>
    <% end %>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :body %>
    <%= form.text_area :body, rows: 8 %>
  </div>

  <div>
    <%= form.label :image %>
    <%= form.file_field :image %>
  </div>

  <%= form.submit %>
<% end %>