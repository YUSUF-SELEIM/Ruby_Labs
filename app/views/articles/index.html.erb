<h1>Articles</h1>

<% if authenticated? %>
  <%= link_to "Write Article", new_article_path %>
<% end %>

<% if @articles.empty? %>
  <p>No articles yet.</p>
<% else %>
  <% @articles.each do |article| %>
    <div style="border: 1px solid #ccc; margin: 10px; padding: 10px;">
      <h2><%= link_to article.title, article_path(article) %></h2>
      <p>By: <%= article.user.email_address %></p>
      <p>Reports: <%= article.reports_count %></p>

      <% if article.image.attached? %>
        <%= image_tag article.image, style: "max-width: 200px" %>
      <% end %>

      <% if authenticated? && Current.user == article.user %>
        <%= link_to "Edit", edit_article_path(article) %>
        <%= button_to "Delete", article_path(article),
              method: :delete,
              data: { turbo_confirm: "Delete this article?" } %>
      <% end %>
    </div>
  <% end %>
<% end %>