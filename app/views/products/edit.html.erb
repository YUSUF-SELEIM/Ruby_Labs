<h1>Edit Product</h1>

<%= form_with model: @product do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :price %>
    <%= form.text_field :price %>
  </div>
  <%= form.submit "Update Product" %>
<% end %>

<%= link_to "Cancel", product_path(@product) %>