<h1>New Product</h1>

<%= form_with model: @product do |form| %>
  <% if @product.errors.any? %>
    <div>
      <% @product.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :price %>
    <%= form.text_field :price %>
  </div>

  <%= form.submit "Create Product" %>
<% end %>

<%= link_to "Back", products_path %>